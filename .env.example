# Salesforce Connected App (OAuth 2.0)
# Copy this file to ".env" in the project root and fill in values.
# Callback URL here must match the Connected App exactly (including port and path).

SF_CLIENT_ID=your_connected_app_consumer_key
SF_CALLBACK_URL=http://localhost:5173/oauth/callback

# Important: use domain with .my.salesforce.com
SF_LOGIN_URL=https://yoursandboxdomain.sandbox.my.salesforce.com
